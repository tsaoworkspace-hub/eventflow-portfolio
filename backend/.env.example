# The demo runs without secret values. These are only needed for optional integrations.
APP_DEMO_MODE=true
SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:5173

# Optional Google Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_KEY=

# Optional production database override
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=eventflow;encrypt=true;trustServerCertificate=true

# Optional mail service override
MAIL_HOST=localhost
MAIL_PORT=2525
